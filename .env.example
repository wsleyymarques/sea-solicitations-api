# Copie este arquivo para .env antes de iniciar o Docker Compose.

APP_PORT=8080

POSTGRES_PORT=5432
POSTGRES_DB=solicitations
POSTGRES_USER=solicitations
POSTGRES_PASSWORD=change-me-for-local-development

ELASTICSEARCH_PORT=9200

# Integracao ViaCEP (opcional; estes sao os valores padrao)
VIACEP_BASE_URL=https://viacep.com.br
VIACEP_CONNECT_TIMEOUT=2s
VIACEP_READ_TIMEOUT=3s

JWT_ISSUER=sea-solicitations-api
JWT_ACCESS_TOKEN_TTL=1h
# Gere com: openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-base64-secret
